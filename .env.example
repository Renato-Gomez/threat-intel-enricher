# Environment variables template
# Copy this file as '.env' and enter your real keys.
# The real '.env' file is ignored in .gitignore for security.

# ARCHITECTURAL NOTE:
# The application will automatically load ANY variable ending in '_API_KEY'.
# This allows you to add new providers without modifying the src/config.py code.

# AbuseIPDB API Key (Get it at https://www.abuseipdb.com/)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# VirusTotal API Key (Get it at https://www.virustotal.com/)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# If you want to add a new API in the future, simply add:
# EXAMPLE_API_KEY=...
